{
  "schemaVersion": 1,
  "id" : "${flywheel_id}",
  "version" : "${flywheel_version}",
  "name" : "${flywheel_name}",
  "description" : "${flywheel_description}",
  "authors": [
    "Jozufozu",
    "PepperCode1"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "dev.djefrey.colorwheel.fabric.ClrwlFabric"
    ],
    "client": [
      "dev.engine_room.flywheel.impl.FlywheelFabric",
      "dev.djefrey.colorwheel.fabric.client.ClrwlFabricClient"
    ]
  },
  "mixins": [
    "flywheel.backend.mixins.json",
    "flywheel.impl.mixins.json",
    "flywheel.impl.fabric.mixins.json",
    "flywheel.impl.sodium.mixins.json",
    "colorwheel.mixins.json",
    "colorwheel.fabric.mixins.json"
  ],
  "suggests": {
    "iris": ">=1.7.0"
  },
  "depends": {
    "minecraft": "${minecraft_semver_version_range}",
    "fabricloader": ">=0.15.0",
    "fabric-api": "${fabric_api_version_range}"
  },
  "breaks": {
    "sodium": ["<0.5.0", "~0.6.0- <0.6.0-beta.2"],
    "embeddium": "*"
  }
}
